# Telegram bot token — get this from @BotFather (send /newbot, follow prompts).
TELEGRAM_TOKEN=

# Optional: only respond to this chat id (your DM with the bot, or a group id).
# Leave blank to allow anyone who messages the bot. Find your id by messaging the
# bot once and watching the console — it logs the chat id of every message.
ALLOWED_CHAT_ID=

# Path to the claude CLI. Run `which claude` to find it.
CLAUDE_BIN=claude

# Optional: working directory Claude runs in (e.g. a repo it should read).
# Leave blank to use the bot's cwd.
CLAUDE_WORKDIR=

# Toolset Claude is allowed to use. Add MCP tools to let it touch Zoho/Airtable/etc.
# Read-only default below. Widen carefully.
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob,WebFetch,WebSearch
